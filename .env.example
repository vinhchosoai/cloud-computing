# API Security
API_KEYS=dev-secret-key-change-me,bench-secret-key-change-me
BENCHMARK_API_KEY=bench-secret-key-change-me
RATE_LIMIT=60/minute
BENCHMARK_RATE_LIMIT=10000/minute

# Model Configuration
MODEL_TYPE=distilbert_onnx
MODEL_DIR=artifacts/distilbert_sst2_int8
MODEL_VERSION=1.0.0
EXPECTED_SHA256=

# Inference Limits
MAX_BATCH_SIZE=32
MAX_TEXT_LENGTH=512

# Drift Detection
DRIFT_WINDOW_SIZE=200
DRIFT_PSI_THRESHOLD=0.20

# Grafana (for docker-compose)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana

